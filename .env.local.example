# 로컬 개발용 — 복사해서 .env.local 로 (커밋 금지). 기본값은 docker compose(npm run db:up) 기준이라 그대로 쓰면 된다.
DATABASE_URL=postgresql://gforest_app:gforest_app@localhost:5432/gforest
AUTH_SECRET=local-dev-secret-change-if-you-like
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 미디어: docker compose 의 MinIO (S3 호환). 키는 MinIO 컨테이너의 고정값이며 AWS 키가 아니다.
S3_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=gforest-media-local
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# 메일: MAIL_FROM 이 없으면 발송 대신 콘솔에 출력한다(비밀번호 재설정 링크는 서버 로그에서 확인).
# MAIL_FROM=noreply@gforest.or.kr
# 공개 미디어 CDN(CloudFront) 도입 후: MEDIA_PUBLIC_BASE_URL=https://media.gforest.or.kr
