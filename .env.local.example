# 로컬 개발용 — 복사해서 .env.local 로 (커밋 금지)
# dev RDS 접속 문자열: AWS_PROFILE=gforest aws ssm get-parameter --with-decryption --name /gforest/dev/DATABASE_URL --query Parameter.Value --output text
DATABASE_URL=postgresql://gforest_app:PASSWORD@gforest-dev.xxxx.ap-northeast-2.rds.amazonaws.com:5432/gforest?sslmode=require
AUTH_SECRET=change-me-openssl-rand-base64-48
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# S3 미디어 (로컬에서는 aws sso login --profile gforest 후 AWS_PROFILE=gforest 로 실행)
MEDIA_BUCKET=gforest-media-dev-106360388338
AWS_REGION=ap-northeast-2
# 선택: CloudFront 공개 미디어 도메인, SES 발신 주소
# MEDIA_PUBLIC_BASE_URL=https://dev.gforest.or.kr/media
# MAIL_FROM=noreply@gforest.or.kr
