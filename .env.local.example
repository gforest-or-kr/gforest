# 로컬 개발용 — 복사해서 .env.local 로 (커밋 금지). 기본값은 docker compose(npm run db:up) 기준이라 그대로 쓰면 된다.
DATABASE_URL=postgresql://gforest_app:gforest_app@localhost:5432/gforest
AUTH_SECRET=local-dev-secret-change-if-you-like
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 미디어: docker compose 의 MinIO (S3 호환). 키는 MinIO 컨테이너의 고정값이며 AWS 키가 아니다.
S3_ENDPOINT=http://localhost:9000
MEDIA_BUCKET=gforest-media-local
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# 메일: MAIL_FROM 이 없으면 발송 대신 콘솔에 출력한다(비밀번호 재설정 링크는 서버 로그에서 확인).
# MAIL_FROM=noreply@gforest.or.kr
# 공개 미디어 CDN(CloudFront) 도입 후: MEDIA_PUBLIC_BASE_URL=https://media.gforest.or.kr

# 이해관계자 질의서(/survey) — 둘 다 없어도 동작한다(서버 로그에 경고 한 줄).
# SURVEY_CLOSES_AT: 응답 마감 일시. 비우면 마감 없이 열려 있다. 받는 형태는 셋뿐이다:
#   2026-11-06T23:59(:59)  오프셋이 없으면 한국 시각(KST). T 대신 공백도 된다
#   2026-11-06T23:59+09:00  오프셋(또는 Z)이 있으면 그대로
#   2026-11-06              날짜만 쓰면 그날 23:59:59(KST)까지 열려 있다
#   그 밖의 값(2026/11/06 등)은 해석 불가 → 마감 없이 열어 두고 서버 로그에 경고를 남긴다.
# SURVEY_CLOSES_AT=2026-11-06T23:59
# SURVEY_HASH_SALT: '중복 의심' 해시용 비밀 솔트. 로컬은 아무 문자열이나 된다. 없으면 AUTH_SECRET 에서 파생하고,
#   둘 다 없으면 해시를 저장하지 않는다. 운영 값은 SSM /gforest/<env>/SURVEY_HASH_SALT (이 작업 범위 밖, 후속).
# SURVEY_HASH_SALT=local-survey-salt
