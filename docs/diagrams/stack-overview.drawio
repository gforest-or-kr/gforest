        <!-- ===== 푸터 ===== -->
        <mxCell id="footer" value="핵심 차이 — 서버 관리 → 컨테이너·코드(Terraform) 관리  ·  SPA → 서버 렌더  ·  별도 API 서버 → 같은 프로세스  ·  앱 권한 검사 → DB(RLS)가 강제" style="text;html=1;fontSize=11;fontStyle=2;fontColor=#57606a;align=center;" vertex="1" parent="1">
