        <mxCell id="ra0" value="컨테이너 web :3000" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#c45500;dashed=1;fontSize=10;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rInfra" target="rFront">
          <mxGeometry relative="1" as="geometry"><mxPoint x="66" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="ra1" value="같은 프로세스 (함수 호출)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2f9e6e;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rFront" target="rBack">
          <mxGeometry relative="1" as="geometry"><mxPoint x="82" y="0" as="offset" /></mxGeometry>
        </mxCell>
        <mxCell id="ra2" value="pg · withUser(userId) · SG 5432" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1d6845;fontSize=10;fontStyle=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rBack" target="rDb">
          <mxGeometry relative="1" as="geometry"><mxPoint x="94" y="0" as="offset" /></mxGeometry>
