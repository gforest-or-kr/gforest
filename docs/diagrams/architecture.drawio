  <diagram name="architecture" id="arch-aws-1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 왼쪽: 사용자 · DNS · CI · 계정 체계 ===== -->
        <mxCell id="user" value="👤 사용자 브라우저&#10;(학부모·회원·방문자)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#effaf3;strokeColor=#2f9e6e;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cafe24" value="🌐 cafe24 DNS (현재 권한 DNS)&#10;gforest.or.kr / dev.gforest.or.kr" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="r53" value="🌐 Route 53 존 (AWS, 글로벌)&#10;NS 전환 예정 — 전환 전까지 트래픽 무관&#10;ACM 검증 레코드 보관" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gha" value="⚙️ GitHub Actions (ecs-deploy.yml)&#10;OIDC 롤 인수 → 이미지 빌드·push → ECS 배포&#10;(상세: cicd.drawio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="acct" value="🔑 계정 체계&#10;• AWS 계정 1개, root 봉인(MFA·액세스 키 없음)&#10;• 사람: IAM Identity Center(SSO, admins 8h)&#10;• CI: GitHub OIDC 롤 gforest-github-deploy&#10;• 장기 액세스 키는 어디에도 없음&#10;• 앵커 메일·시드는 Bitwarden 조직 금고" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fffaf0;strokeColor=#94733b;fontSize=10;align=left;spacingLeft=6;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="200" height="130" as="geometry" />
        </mxCell>

        <!-- ===== AWS 리전 박스 ===== -->
        <mxCell id="region" value="☁️ AWS — 리전 ap-northeast-2 서울 (Terraform 관리: infra/shared · infra/env dev/prod)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#c45500;verticalAlign=top;fontSize=13;fontStyle=1;spacingTop=6;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="40" width="860" height="650" as="geometry" />
        </mxCell>

