        <!-- ===== 개발자 · 수동 실행 · infra.yml ===== -->
        <mxCell id="dev" value="👩‍💻 개발자 (협업자 누구나)&#10;브랜치 → Pull Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#effaf3;strokeColor=#2f9e6e;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wfInfra" value="⚙️ infra.yml (infra/** PR만)&#10;terraform fmt -check / validate&#10;+ OIDC 롤 인수 확인&#10;(sts get-caller-identity)&#10;apply는 CI에서 하지 않음" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="manual" value="🖱️ 수동 실행 (workflow_dispatch)&#10;environment = prod&#10;GitHub environment 승인 규칙 적용 가능" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8c5;strokeColor=#9a6700;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- ===== GitHub ===== -->
        <mxCell id="gh" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f6f8fa;strokeColor=#24292f;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="290" y="40" width="300" height="420" as="geometry" />
