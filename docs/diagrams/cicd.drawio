          <mxGeometry x="650" y="48" width="320" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="① OIDC 롤 인수 — gforest-github-deploy&#10;(장기 액세스 키 없음, id-token: write)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="80" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="② Docker 빌드 — linux/arm64 네이티브 (QEMU 없음)&#10;build-arg NEXT_PUBLIC_SITE_URL · GHA 캐시" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="150" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="③ ECR push — sha-&lt;commit&gt; + &lt;env&gt;-latest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="220" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="④ 태스크 정의 갱신 — 최신 리비전 복제, 이미지만 교체&#10;(환경변수·시크릿·크기는 Terraform 값 유지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="290" width="300" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="⑤ ECS 롤아웃 — update-service → services-stable 대기&#10;실패 시 서킷 브레이커가 이전 태스크 정의로 자동 롤백" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7f0e2;strokeColor=#1d6845;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="660" y="360" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="⑥ 스모크 — ALB에 직접 curl -H &quot;Host: …&quot; /api/health&#10;(DNS 전환 여부와 무관, 10회 재시도)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0969da;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="660" y="450" width="300" height="50" as="geometry" />
