        </mxCell>
        <mxCell id="wfCi" value="⚙️ ci.yml (PR 게이트)&#10;npm ci → tsc --noEmit → eslint → next build&#10;DB 없이 통과해야 한다 (빌드 시점 DB 접근 금지)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ddf4ff;strokeColor=#0969da;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="350" y="160" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="main" value="main 브랜치 (squash 병합 전용)&#10;코드·SQL 마이그레이션·워크플로 = 단일 진실" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#24292f;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="310" y="360" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- ===== ecs-deploy.yml ===== -->
        <mxCell id="deploy" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef6ff;strokeColor=#0969da;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="340" height="500" as="geometry" />
